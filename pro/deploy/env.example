# Settings for the service. In Cloud Run these are set as environment variables; secrets come from Secret Manager.
# Never put real values in this file or commit them.

NODE_ENV=production
BASE_URL=https://your-domain.example            # the public address, https
SESSION_SECRET=                                  # SECRET: 32+ random characters. Changing it signs everyone out.
BRAND_NAME=Next Stop                             # working title: change it
PLAN_NAME=Plus
ADMIN_EMAILS=you@example.com                     # who can see unchecked drafts

DATA_STORE=firestore
FIRESTORE_PROJECT=your-gcp-project-id

MAILER=resend
MAIL_FROM="Next Stop <hello@your-domain.example>"
RESEND_API_KEY=                                  # SECRET

STRIPE_SECRET_KEY=                               # SECRET (start with a test key: sk_test_...)
STRIPE_WEBHOOK_SECRET=                           # SECRET (whsec_...)
STRIPE_PRICE_MONTHLY=price_...
STRIPE_PRICE_PASS=price_...
PRICE_MONTHLY_LABEL=£6.99 a month                # shown on the Plans page: must match the Stripe price
PRICE_PASS_LABEL=90-day pass £14.99
PASS_DAYS=90

MARKING_PROVIDER=vertex                          # vertex | anthropic | off
VERTEX_PROJECT=your-gcp-project-id
VERTEX_LOCATION=europe-west2
VERTEX_MODEL=gemini-2.5-flash                    # check the current model names in the Vertex AI console
# ANTHROPIC_API_KEY=                             # SECRET, only if MARKING_PROVIDER=anthropic
# MODEL=claude-sonnet-5-5

QUOTA_MONTHLY_MARKS=40                           # AI feedbacks per Plus learner per month
MARKS_DAILY_CAP=300                              # all learners together, per day (your budget brake)
MARKS_PER_USER_PER_HOUR=8
